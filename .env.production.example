# ── Backend API ───────────────────────────────────────────────────────────────

# PostgreSQL (Railway plugin URL or external)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/repograph

# Auth
API_KEY=                        # generate: openssl rand -hex 32

# Neo4j AuraDB (cloud) or self-hosted
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# Embedding (keep defaults unless changing models)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Git repo clone storage (use a named Docker volume path)
REPO_BASE_PATH=/app/repositories

# Environment flag (enables production safety checks)
ENVIRONMENT=production

# Postgres credentials (used by the postgres service in compose)
POSTGRES_USER=repograph
POSTGRES_PASSWORD=                # generate: openssl rand -hex 16
POSTGRES_DB=repograph


# ── Frontend (build args + runtime) ──────────────────────────────────────────

# API location (set at Next.js build time)
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_API_KEY is set from API_KEY above in docker-compose.prod.yml

# NextAuth
NEXTAUTH_URL=https://your-frontend.up.railway.app
NEXTAUTH_SECRET=                  # generate: openssl rand -base64 32

# GitHub OAuth App (create at github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional — create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
